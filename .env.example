# Public canonical origin (configuration only; no credentials).
SITE_ORIGIN=http://localhost:3000
# Server-only Laravel origin. Never use NEXT_PUBLIC_ for this setting.
DONATIONS_BACKEND_ORIGIN=http://127.0.0.1:8000
# Opt-in GET-only bridge; ignored outside next dev.
LOCAL_PUBLIC_API_PROXY=true
# Financial operations stay disabled. These are non-secret operator attestations,
# not automatic verification. Do not enable before the Phase 02E return exists.
DONATIONS_MUTATIONS_ENABLED=false
DONATIONS_INTEGRATION_VERIFIED=false
DONATIONS_PAYMENT_RETURN_VERIFIED=false
DONATIONS_VERIFIED_RETURN_URL=
DONATIONS_GATEWAY_CODE=
# Exact lower-case DNS hosts, comma-separated; no wildcard, URL, path or port.
# Derive approved values from the selected gateway's reviewed configuration.
DONATIONS_CHECKOUT_HOSTS=
